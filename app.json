{
  "expo": {
    "name": "RoofCheck",
    "slug": "claim-capture",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cameraapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.devwisecodesteam.claimcapture",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow CameraApp to take photos.",
        "NSPhotoLibraryUsageDescription": "Allow CameraApp to save photos to your gallery.",
        "NSPhotoLibraryAddUsageDescription": "Allow CameraApp to save photos to your gallery.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#133A42",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "package": "com.devwisecodesteam.claimcapture",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F7F8",
          "dark": {
            "backgroundColor": "#133A42"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CameraApp to take photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow RoofCheck to take inspection photos.",
          "photosPermission": "Allow RoofCheck to access inspection photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow CameraApp to access your photos.",
          "savePhotosPermission": "Allow CameraApp to save photos to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#133A42",
          "defaultChannel": "jobs"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "20211921-c735-4707-b56d-66186ff654d2"
      }
    },
    "owner": "devwisecodes-team"
  }
}
